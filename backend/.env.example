# Copy this file to .env and replace placeholders for local use.
# The backend loads .env from its working directory. Never commit or share a filled .env.

SPRING_PROFILES_ACTIVE=dev

# AWS DynamoDB and S3
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=replace_with_aws_access_key_id
AWS_SECRET_ACCESS_KEY=replace_with_aws_secret_access_key
AWS_S3_BUCKET=replace_with_aws_s3_bucket
DYNAMODB_ENDPOINT=
DYNAMODB_AUTO_CREATE_TABLES=true
DYNAMODB_BILLING_MODE=PAY_PER_REQUEST

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Application integrations
GEMINI_API_KEY=
APP_WHISPER_URL=http://localhost:8000
FIREBASE_CONFIG_PATH=
FIREBASE_DATABASE_URL=

# SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=replace_with_smtp_username
MAIL_PASSWORD=replace_with_smtp_app_password
MAIL_SECURE=true

# Authentication
JWT_SECRET=replace_with_a_long_random_secret
SECURITY_USER_NAME=admin
SECURITY_USER_PASSWORD=replace_with_a_strong_password

# Twilio SMS
TWILIO_ACCOUNT_SID=replace_with_twilio_account_sid
TWILIO_AUTH_TOKEN=replace_with_twilio_auth_token
TWILIO_FROM_NUMBER=replace_with_twilio_phone_number

# Agora video calls
AGORA_APP_ID=replace_with_agora_app_id
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_EXPIRY_SECONDS=3600

# Required only by docker-compose.prod.yml
DOCKER_HUB_USERNAME=replace_with_docker_hub_username
GROQ_API_KEY=
